{
  "description": "sdlc-team-kit guardrails: protected branches (git and GitHub tools), no agent merges, design gate on story branches, secrets and locked tests",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
